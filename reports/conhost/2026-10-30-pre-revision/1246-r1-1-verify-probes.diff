+    #[test]
+    fn probe_f8_second_cooked_read_overwrites_rest() {
+        let mut h = Host::new();
+        let [_, input, _] = h.connect(1, "");
+        let a = read_w(&mut h, input, 4);
+        let b = read_w(&mut h, input, 64);
+        assert!(held(&a) && held(&b));
+        let fx = h.ev(Event::Input(b"abcdef\rxy\r"));
+        let done = completes(&fx);
+        for d in &done { eprintln!("PROBE F8: done {:?}", wide(d)); }
+        let r = read_w(&mut h, input, 64);
+        eprintln!("PROBE F8: next read held={} got {:?}", held(&r), wide(&r));
+    }
