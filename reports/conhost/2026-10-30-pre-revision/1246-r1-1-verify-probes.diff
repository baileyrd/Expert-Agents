+    #[test]
+    fn probe_f17_close_other_handle() {
+        let mut h = Host::new();
+        let [_, input, _] = h.connect(1, "");
+        let second = h.create(1, msg::OBJECT_GENERIC, msg::GENERIC_READ | msg::GENERIC_WRITE).information;
+        let a = read_w(&mut h, input, 8);
+        let b = read_w(&mut h, second, 8);
+        assert!(held(&a) && held(&b));
+        let (_, fx) = h.packet(msg::CLOSE_OBJECT, 1, second, &[], 0);
+        eprintln!("PROBE F17: completed on close of second: {}", completes(&fx).len());
+    }
