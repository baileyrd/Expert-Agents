+    // ===== verifier probes =====
+    #[test]
+    fn probe_f1_paste_over_4096_into_waiting_cooked_read() {
+        let mut h = Host::new();
+        let [_, input, _] = h.connect(1, "");
+        let r = read_w(&mut h, input, 32768);
+        assert!(held(&r));
+        let mut bytes = vec![b'a'; 5000];
+        bytes.push(b'\r');
+        let fx = h.ev(Event::Input(&bytes));
+        let done = completes(&fx);
+        let n = done.first().map(|d| wide(d).len()).unwrap_or(0);
+        eprintln!("PROBE F1: completed={} returned_chars={} (expect 5002) dropped_logged={}", done.len(), n, fx.contains(&Effect::Log(Diag::InputDropped)));
+    }
+
+    #[test]
+    fn probe_f3_reply_size() {
+        let mut h = Host::new();
+        let [_, input, _] = h.connect(1, "");
+        h.set_mode(input, RAW);
+        // 100 win32 records each repeating 'a' 65535 times: ~2.1 KB input.
+        let inp = b"\x1b[65;0;97;1;0;65535_".repeat(100);
+        h.ev(Event::Input(&inp));
+        let r = read_w(&mut h, input, u32::MAX - 64);
+        eprintln!("PROBE F3: input_bytes={} reply_bytes={}", inp.len(), r.output.len());
+    }
+
+    #[test]
+    fn probe_f4_ctrl_c_effects() {
+        let mut h = Host::new();
+        for pid in 0..256 { h.connect(1000 + pid, ""); }
+        let bytes = vec![0x03u8; 16 * 1024];
+        let fx = h.ev(Event::Input(&bytes));
+        eprintln!("PROBE F4: effects={} ctrl={} size_of_Effect={} bytes~={}", fx.len(), ctrls(&fx).len(), std::mem::size_of::<Effect>(), fx.len()*std::mem::size_of::<Effect>());
+    }
