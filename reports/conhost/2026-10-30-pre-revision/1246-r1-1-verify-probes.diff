+    #[test]
+    fn probe_f7_echo_controls() {
+        let mut h = Host::new();
+        let [_, input, _] = h.connect(1, "");
+        let _r = read_w(&mut h, input, 512);
+        h.ev(Event::Input(b"\x01\x0e"));
+        h.ev(Event::Input("\u{4e2d}\x7f".as_bytes()));
+        eprintln!("PROBE F7a: echo {:?}", String::from_utf8_lossy(&h.vt));
+        let mut h = Host::new();
+        let [_, input, _] = h.connect(1, "");
+        h.set_mode(input, mode::PROCESSED_INPUT | mode::LINE_INPUT | mode::ECHO_INPUT | mode::VIRTUAL_TERMINAL_INPUT);
+        let _r = read_w(&mut h, input, 512);
+        h.ev(Event::Input(b"\x1b[A"));
+        eprintln!("PROBE F7b: vt echo {:?}", String::from_utf8_lossy(&h.vt));
+    }
