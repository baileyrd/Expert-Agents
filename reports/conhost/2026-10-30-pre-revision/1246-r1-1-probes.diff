+    #[test]
+    fn probe_echo_amplification() {
+        let mut h = Host::new();
+        let [_, input, _] = h.connect(1, "");
+        let r = read_w(&mut h, input, 64);
+        assert!(held(&r));
+        let mut bytes = Vec::new();
+        while bytes.len() + 36 <= crate::sched::INPUT_SLICE {
+            bytes.extend_from_slice(b"\x1b[65;0;97;1;0;65535_");
+            bytes.extend_from_slice(b"\x1b[27;0;27;1;0;1_");
+        }
+        let before = h.vt.len();
+        h.ev(Event::Input(&bytes));
+        eprintln!("PROBE echo: input {} B -> echo {} B", bytes.len(), h.vt.len() - before);
+        // plain bytes, no repeat count
+        let mut h = Host::new();
+        let [_, input, _] = h.connect(1, "");
+        read_w(&mut h, input, 64);
+        let mut bytes = Vec::new();
+        while bytes.len() + 8192 + 16 <= crate::sched::INPUT_SLICE {
+            bytes.extend(std::iter::repeat(b'a').take(8192));
+            bytes.extend_from_slice(b"\x1b[27;0;27;1;0;1_");
+        }
+        h.ev(Event::Input(&bytes));
+        eprintln!("PROBE echo plain: input {} B -> echo {} B", bytes.len(), h.vt.len());
+    }
